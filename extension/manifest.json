{
  "manifest_version": 3,
  "name": "JobPilot Assist",
  "version": "1.5.0",
  "description": "Read the job you are viewing on any job board or company careers page, draft a tailored cover letter, and fill the application form, resume included.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://ai-job-application-agent-pi.vercel.app/*",
    "https://www.linkedin.com/*",
    "https://in.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://www.indeed.com/*",
    "https://in.indeed.com/*",
    "https://www.glassdoor.co.in/*",
    "https://www.glassdoor.com/*",
    "https://wellfound.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.freshteam.com/*",
    "https://*.keka.com/*",
    "https://*.darwinbox.in/*",
    "https://*.zohorecruit.in/*",
    "https://*.zohorecruit.com/*",
    "https://www.instahyre.com/*",
    "https://www.foundit.in/*",
    "https://cutshort.io/*",
    "https://internshala.com/*",
    "https://www.iimjobs.com/*",
    "https://smartapply.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot Assist"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://in.linkedin.com/*",
        "https://www.naukri.com/*",
        "https://www.indeed.com/*",
        "https://in.indeed.com/*",
        "https://www.glassdoor.co.in/*",
        "https://www.glassdoor.com/*",
        "https://wellfound.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.freshteam.com/*",
        "https://*.keka.com/*",
        "https://*.darwinbox.in/*",
        "https://*.zohorecruit.in/*",
        "https://*.zohorecruit.com/*",
        "https://www.instahyre.com/*",
        "https://www.foundit.in/*",
        "https://cutshort.io/*",
        "https://internshala.com/*",
        "https://www.iimjobs.com/*",
        "https://smartapply.indeed.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
