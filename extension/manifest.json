{
  "manifest_version": 3,
  "name": "JobPilot Assist",
  "version": "1.8.0",
  "description": "Spots the job you are viewing, pops up with an AI fit check, drafts letters and screening answers in your voice, and fills the application form, resume included.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://ai-job-application-agent-pi.vercel.app/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.linkedin.com/*",
    "https://in.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://www.indeed.com/*",
    "https://in.indeed.com/*",
    "https://www.glassdoor.co.in/*",
    "https://www.glassdoor.com/*",
    "https://wellfound.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.freshteam.com/*",
    "https://*.keka.com/*",
    "https://*.darwinbox.in/*",
    "https://*.zohorecruit.in/*",
    "https://*.zohorecruit.com/*",
    "https://www.instahyre.com/*",
    "https://www.foundit.in/*",
    "https://cutshort.io/*",
    "https://internshala.com/*",
    "https://www.iimjobs.com/*",
    "https://smartapply.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot Assist"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://in.linkedin.com/*",
        "https://www.naukri.com/*",
        "https://www.indeed.com/*",
        "https://in.indeed.com/*",
        "https://www.glassdoor.co.in/*",
        "https://www.glassdoor.com/*",
        "https://wellfound.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.freshteam.com/*",
        "https://*.keka.com/*",
        "https://*.darwinbox.in/*",
        "https://*.zohorecruit.in/*",
        "https://*.zohorecruit.com/*",
        "https://www.instahyre.com/*",
        "https://www.foundit.in/*",
        "https://cutshort.io/*",
        "https://internshala.com/*",
        "https://www.iimjobs.com/*",
        "https://smartapply.indeed.com/*"
      ],
      "js": [
        "content.js",
        "launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open or close the JobPilot panel on this page"
    }
  }
}